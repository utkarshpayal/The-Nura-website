{
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "rewrites": [
    { "source": "/sitemap-blog.xml", "destination": "https://www.backend.thenura.care/api/blogs/public/sitemap.xml" },
    { "source": "/((?!\\.well-known/|sitemap-blog\\.xml).*)", "destination": "/index.html" }
  ]
}
